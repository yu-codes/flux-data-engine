# Copy to .env and adjust. Every variable is read by backend/app/core/config.py.

# --- database -------------------------------------------------------------
POSTGRES_USER=flux
POSTGRES_PASSWORD=flux
POSTGRES_DB=flux

# --- storage --------------------------------------------------------------
# "local" writes Parquet, result payloads and artifacts to a volume;
# "s3" routes them to the MinIO service (or any S3-compatible endpoint).
FLUX_STORAGE_BACKEND=local
FLUX_S3_BUCKET=flux
MINIO_ROOT_USER=flux
MINIO_ROOT_PASSWORD=fluxflux

# --- execution ------------------------------------------------------------
# "inline" runs an execution inside the request; "queue" hands it to the
# worker over Redis and returns a pending execution immediately.
FLUX_EXECUTION_MODE=inline
FLUX_SCHEDULER_ENABLED=true

# --- security -------------------------------------------------------------
FLUX_AUTH_ENABLED=true
# CHANGE THIS before exposing the deployment: it signs every access token.
FLUX_SECRET_KEY=dev-only-insecure-key-change-me
FLUX_BOOTSTRAP_ADMIN_EMAIL=admin@flux.local
FLUX_BOOTSTRAP_ADMIN_PASSWORD=flux-admin

# --- misc -----------------------------------------------------------------
FLUX_DEBUG=false
FLUX_SEED_ON_STARTUP=true

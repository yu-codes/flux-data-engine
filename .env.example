# Copy to .env and adjust. Every variable is read by backend/app/core/config.py.

# --- database -------------------------------------------------------------
FLUX_DATABASE_URL=postgresql+psycopg://flux:flux@postgres:5432/flux
POSTGRES_USER=flux
POSTGRES_PASSWORD=flux
POSTGRES_DB=flux

# --- storage --------------------------------------------------------------
# Object store root for dataset Parquet files, result payloads and artifacts.
FLUX_STORAGE_ROOT=/app/var/storage
FLUX_DATA_ROOT=/app/data

# --- execution ------------------------------------------------------------
# "inline" runs an execution in the request. A queue-backed worker plugs in here.
FLUX_EXECUTION_MODE=inline
FLUX_REDIS_URL=redis://redis:6379/0

# --- MinIO (object storage service; the S3 backend is not wired up yet) ----
MINIO_ROOT_USER=flux
MINIO_ROOT_PASSWORD=fluxflux

# --- misc -----------------------------------------------------------------
FLUX_DEBUG=false
FLUX_SEED_ON_STARTUP=true
